# ===========================================================================
# Zuber Carrelage — Environment Variables
# Copy this file to .env.development (local) and set values in your host's
# environment panel (Railway, Netlify, Vercel, …).
# NEVER commit .env.development or .env.local to version control.
# ===========================================================================

# ---------------------------------------------------------------------------
# Railway / Strapi backend
# Used for all CMS content AND for the Instagram exclusions feature
# (InstagramCarousel component + /api/admin/instagram-exclusions API route).
# ---------------------------------------------------------------------------
GATSBY_STRAPI_URL=https://your-strapi-instance.up.railway.app
GATSBY_STRAPI_TOKEN=your_strapi_api_token

# ---------------------------------------------------------------------------
# Instagram feed API (Railway)
# Leave empty to use the default production URL baked into the component.
# ---------------------------------------------------------------------------
GATSBY_INSTAGRAM_FEED_URL=https://instagram-feed-api-production.up.railway.app/api/feed

# ---------------------------------------------------------------------------
# Admin password for /admin/instagram (NO GATSBY_ prefix → server-side only)
# Validated server-side in the API route; never compared in browser JS.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=your_secure_admin_password
